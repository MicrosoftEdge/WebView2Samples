<Window x:Class="WebView2WpfBrowser.ClusterEnvironmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebView2WpfBrowser"
        mc:Ignorable="d"
        Title="Shared Cluster Environment"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Hosts that pass the same ClusterName and the same options share a single browser process. The first host to create the cluster pins these options; a later host that asks for a different set gets an options mismatch."/>

        <TextBlock x:Name="ClusterNameLabel" Text="ClusterName"/>
        <TextBox x:Name="ClusterNameInput" Margin="0,2,0,8"
                 AutomationProperties.LabeledBy="{Binding ElementName=ClusterNameLabel}"/>

        <TextBlock x:Name="LanguageLabel" Text="Language"/>
        <TextBox x:Name="LanguageInput" Margin="0,2,0,8"
                 AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"/>

        <TextBlock x:Name="BrowserArgsLabel" Text="AdditionalBrowserArguments"/>
        <TextBox x:Name="BrowserArgsInput" Margin="0,2,0,8"
                 AutomationProperties.LabeledBy="{Binding ElementName=BrowserArgsLabel}"/>

        <TextBlock Text="Options" Margin="0,4,0,2"/>
        <CheckBox x:Name="SingleSignOnInput" Content="AllowSingleSignOnUsingOSPrimaryAccount" Margin="0,2"/>
        <CheckBox x:Name="TrackingPreventionInput" Content="EnableTrackingPrevention" Margin="0,2"/>
        <CheckBox x:Name="BrowserExtensionsInput" Content="AreBrowserExtensionsEnabled" Margin="0,2"/>
        <CheckBox x:Name="ProfileIsolationInput" Content="PerHostProfileIsolation" Margin="0,2,0,8"/>

        <TextBlock Text="ReleaseChannels" Margin="0,4,0,2"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                    AutomationProperties.Name="ReleaseChannels">
            <CheckBox x:Name="StableInput" Content="Stable" Margin="0,0,12,0"/>
            <CheckBox x:Name="BetaInput" Content="Beta" Margin="0,0,12,0"/>
            <CheckBox x:Name="DevInput" Content="Dev" Margin="0,0,12,0"/>
            <CheckBox x:Name="CanaryInput" Content="Canary"/>
        </StackPanel>

        <TextBlock x:Name="SearchKindLabel" Text="ChannelSearchKind"/>
        <ComboBox x:Name="SearchKindInput" Margin="0,2,0,12"
                  AutomationProperties.LabeledBy="{Binding ElementName=SearchKindLabel}">
            <ComboBoxItem Content="MostStable"/>
            <ComboBoxItem Content="LeastStable"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="ok_Clicked" IsDefault="True" Width="80" Margin="0,0,8,0">OK</Button>
            <Button IsCancel="True" Width="80">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
